POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=gigtax
POSTGRES_PORT=5432
# Deployed environments (Render + Neon): set DATABASE_URL instead of the five fields
# above — Neon's connection string already includes ?sslmode=require, which the
# discrete fields have no way to express. Leave commented out for local dev.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/gigtax?sslmode=require
GEMINI_API_KEY=your-gemini-api-key-here

# Auth — generate a real random secret for anything beyond local dev, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google Drive BYOS — register an OAuth client (Web application) in Google Cloud Console,
# requesting only the drive.file scope, then fill these in.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET_KEY=your-fernet-key-here

FRONTEND_URL=http://localhost:5173
