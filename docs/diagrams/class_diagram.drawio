<mxfile host="65bd71144e">
    <diagram id="class_diagram_id" name="Class Diagram">
        <mxGraphModel dx="960" dy="848" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml GigTax_Class_Diagram\n'=========================================\n' GigTax — Class Diagram (Advanced UML)\n'=========================================\n\nskinparam class {\n    BackgroundColor White\n    ArrowColor Black\n    BorderColor Black\n}\n\npackage \&quot;GigTax Core Entities\&quot; &lt;&lt;Frame&gt;&gt; {\n\n    class User {\n      +user_id : UUID {id}\n      +email : String\n      +password_hash : String\n      +full_name : String\n      +occupation_type : String\n      +state_of_residence : String\n      +tax_year : Integer\n      --\n      +register() : void\n      +login() : void\n      +updateProfile() : void\n    }\n\n    class StatementUpload {\n      +upload_id : UUID {id}\n      +file_name : String\n      +storage_path : String\n      +upload_date : DateTime\n      +parsing_status : String\n      +error_log : String\n      --\n      +uploadFile() : void\n      +parseData() : void\n      +updateStatus() : void\n    }\n\n    abstract class Transaction {\n      +transaction_id : UUID {id}\n      +date : Date\n      +description : String\n      +amount : Decimal\n      +currency : String\n      +ai_category : String\n      +user_category : String\n      +review_status : String\n      +tax_treatment : String\n      --\n      +createRecord() : void\n      +categorizeViaAI() : void\n      +updateReviewStatus() : void\n    }\n\n    class IncomeRecord {\n      +income_source : String\n      +is_taxable : Boolean\n      --\n      +applyExemption() : void\n    }\n\n    class ExpenseRecord {\n      +expense_type : String\n      +is_deductible : Boolean\n      --\n      +applyDeductionRule() : void\n    }\n\n    class CustomRule {\n      +rule_id : UUID {id}\n      +keyword_pattern : String\n      +assigned_category : String\n      +is_active : Boolean\n      --\n      +createRule() : void\n      +evaluateTransaction() : void\n    }\n\n    class Receipt {\n      +receipt_id : UUID {id}\n      +storage_path : String\n      +upload_date : DateTime\n      +file_type : String\n      --\n      +uploadDocument() : void\n      +linkToTransaction() : void\n    }\n\n    class TaxComputation {\n      +computation_id : UUID {id}\n      +tax_year : Integer\n      +total_income : Decimal\n      +total_deductions : Decimal\n      +statutory_reliefs : Decimal\n      +chargeable_income : Decimal\n      +gross_tax : Decimal\n      +net_tax_payable : Decimal\n      +computation_date : DateTime\n      --\n      +calculateLiability() : void\n      +applyReliefs() : void\n    }\n\n    class TaxReport {\n      +report_id : UUID {id}\n      +file_path : String\n      +generated_date : DateTime\n      --\n      +generatePDF() : void\n      +downloadReport() : void\n    }\n\n    class AIAdvisoryQuery {\n      +query_id : UUID {id}\n      +user_question : String\n      +retrieved_context : String\n      +generated_response : String\n      +timestamp : DateTime\n      --\n      +askQuestion() : void\n      +generateResponse() : void\n    }\n\n    ' Relationships\n    ' Inheritance\n    Transaction &lt;|-- IncomeRecord\n    Transaction &lt;|-- ExpenseRecord\n\n    ' Composition (Solid Diamond)\n    User *-- \&quot;0..*\&quot; StatementUpload\n    User *-- \&quot;0..*\&quot; TaxComputation\n    User *-- \&quot;0..*\&quot; CustomRule\n    User *-- \&quot;0..*\&quot; AIAdvisoryQuery\n    User *-- \&quot;0..*\&quot; Transaction : enters manually\n    \n    StatementUpload *-- \&quot;0..*\&quot; Transaction : parses into\n    TaxComputation *-- \&quot;1\&quot; TaxReport : contains\n\n    ' Aggregation (Hollow Diamond)\n    Transaction o-- \&quot;0..1\&quot; Receipt : supported by\n}\n\n@enduml\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="aQDMQX9k-GFmMJ2xvC8j-1">
                    <mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=14;labelBackgroundColor=none;" parent="1" connectable="0" vertex="1">
                        <mxGeometry width="505.26917000000003" height="695" as="geometry"/>
                    </mxCell>
