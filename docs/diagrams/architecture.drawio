                <UserObject label="" plantUmlData="{&#10;  &quot;data&quot;: &quot;@startuml GigTax_Architecture\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam package {\n    BackgroundColor #F9F9F9\n    BorderColor #333333\n}\nskinparam rectangle {\n    BackgroundColor White\n    BorderColor #333333\n    RoundCorner 8\n}\nskinparam database {\n    BackgroundColor #E6F7FF\n    BorderColor #0066CC\n}\nskinparam cloud {\n    BackgroundColor #F0F0F0\n    BorderColor #666666\n}\n\ntop to bottom direction\n\nrectangle \&quot;Users (Taxpayers)\&quot; as Users\n\npackage \&quot;Client Tier\&quot; {\n    rectangle \&quot;Web Browser\&quot; as Browser\n    rectangle \&quot;Mobile Device\&quot; as Mobile\n}\n\npackage \&quot;Frontend Tier\&quot; {\n    rectangle \&quot;App Frontend\\n(React SPA)\&quot; as Frontend\n}\n\npackage \&quot;Backend Tier\&quot; {\n    rectangle \&quot;API Server\\n(FastAPI)\&quot; as API\n    rectangle \&quot;Tax Computation\\nEngine\&quot; as Engine\n    rectangle \&quot;PDF/CSV\\nParser\&quot; as Parser\n}\n\npackage \&quot;Data Tier\&quot; {\n    database \&quot;Relational Database\\n(PostgreSQL)\&quot; as RDB\n    database \&quot;Vector Database\&quot; as VDB\n}\n\npackage \&quot;Storage Tier\&quot; {\n    rectangle \&quot;Cloud Storage\\n(Files &amp; Receipts)\&quot; as Storage\n}\n\npackage \&quot;AI &amp; External Services\&quot; {\n    cloud \&quot;Language Model\\n(LLM Service)\&quot; as LLM\n}\n\nUsers --&gt; Browser\nUsers --&gt; Mobile\n\nBrowser --&gt; Frontend : HTTPS\nMobile --&gt; Frontend : HTTPS\n\nFrontend --&gt; API : REST API (JSON)\n\nAPI &lt;--&gt; Engine\nAPI &lt;--&gt; Parser\n\nAPI ---&gt; RDB : SQL\nAPI ---&gt; VDB : Vector Search\nAPI ---&gt; Storage : File I/O\nAPI ---&gt; LLM : Prompting\n\n@enduml\n&quot;,&#10;  &quot;config&quot;: null&#10;}" id="5E9ND-a7_Vlg_KJ5M8f0-51">
